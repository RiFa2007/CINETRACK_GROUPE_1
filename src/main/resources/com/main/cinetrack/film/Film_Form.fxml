<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane styleClass="form-root"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../../css/form.css"
            fx:controller="com.main.cinetrack.controllers.FilmControllers.FilmFormController">

    <ScrollPane styleClass="form-scroll" fitToWidth="true" hbarPolicy="NEVER"
                AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <content>
            <VBox spacing="18.0">
                <padding>
                    <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
                </padding>

                <Label text="Créer un film" styleClass="form-titre" />
                <Label text="Remplissez les informations ci-dessous pour ajouter un nouveau film"
                       styleClass="form-sous-titre" wrapText="true" />

                <GridPane hgap="30.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140.0" prefWidth="175.0" hgrow="NEVER" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
                    </columnConstraints>

                    <Label text="Titre du film" styleClass="form-label" GridPane.rowIndex="0" GridPane.valignment="TOP" />
                    <TextField fx:id="champTitre" styleClass="form-champ" maxWidth="Infinity"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Synopsis" styleClass="form-label" GridPane.rowIndex="1" GridPane.valignment="TOP" />
                    <TextArea fx:id="champSynopsis" styleClass="form-champ" wrapText="true" prefRowCount="3"
                              maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Genre" styleClass="form-label" GridPane.rowIndex="2" GridPane.valignment="TOP" />
                    <TextField fx:id="champGenre" styleClass="form-champ" maxWidth="Infinity"
                               GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Durée en minutes" styleClass="form-label" GridPane.rowIndex="3" GridPane.valignment="TOP" />
                    <TextField fx:id="champDuree" styleClass="form-champ" maxWidth="Infinity"
                               GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <VBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                        <Label text="Note / 10" styleClass="form-petit" />
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <HBox fx:id="boiteEtoiles" spacing="2.0" alignment="CENTER_LEFT" />
                            <Label fx:id="labelNote" text="0" styleClass="note-valeur" />
                            <Label text="/ 10" styleClass="form-petit" />
                        </HBox>
                    </VBox>

                    <VBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
                        <Label text="Image" styleClass="form-petit" />
                        <HBox fx:id="zoneImage" styleClass="zone-image" alignment="CENTER_LEFT" spacing="18.0"
                              >
                            <ImageView fx:id="apercuImage" fitWidth="72.0" fitHeight="86.0" preserveRatio="true" />
                            <Label fx:id="labelNomImage" text="Cliquez pour choisir une image" styleClass="form-nom-image" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Region styleClass="icon-image" />
                        </HBox>
                    </VBox>
                </GridPane>

                <HBox alignment="CENTER_RIGHT">
                    <Button fx:id="btnCreer" text="Créer la séance" styleClass="btn-creer" onAction="#ajouterFilm" />
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>