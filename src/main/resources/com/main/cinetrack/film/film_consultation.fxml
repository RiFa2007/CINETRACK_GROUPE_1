<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.main.cinetrack.controllers.FilmControllers.FilmConsultationController">
    <TextField fx:id="bar_de_recherche"/>
    <ChoiceBox fx:id="filtre"/>
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="conteneurFilms" spacing="15.0"/>
        </content>
    </ScrollPane>
</VBox>